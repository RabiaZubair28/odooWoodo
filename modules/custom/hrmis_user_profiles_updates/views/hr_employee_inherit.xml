<odoo>

    <record id="view_employee_form_inherit_hrmis" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.hrmis.profile</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[1]" position="after">

                <group string="HRMIS Staff Profile" col="2">

                    <!-- <button name="action_open_staff_profile"
                            string="Open Staff Profile"
                            type="object"
                            class="oe_highlight"/> -->

                    <group col="2">
                        <group string="Personal Information" col="2">
                            <field name="hrmis_cnic" readonly="1"/>
                            <field name="hrmis_father_name" readonly="1"/>
                            <field name="hrmis_date_of_birth" readonly="1"/>
                            <field name="hrmis_gender" readonly="1"/>
                        </group>

                        <group string="Job Details" col="2">
                            <field name="hrmis_cadre" readonly="1"/>
                            <field name="hrmis_designation" readonly="1"/>
                            <field name="hrmis_bps" readonly="1"/>
                            <field name="hrmis_district_id" readonly="1"/>
                            <field name="hrmis_facility_id" readonly="1"/>
                        </group>
                    </group>

                </group>

            </xpath>

        </field>
    </record>


    <record id="action_open_staff_profile_window" model="ir.actions.act_window">
        <field name="name">Staff Profile</field>
        <field name="res_model">hrmis.user.profile</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
